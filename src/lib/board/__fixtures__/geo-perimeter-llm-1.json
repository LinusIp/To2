[{"id":"p1","type":"explain","say":"Salom! Bugun biz ko'pburchaklar perimetrini o'rganamiz. Perimetr — bu shaklning hamma tomonlari yig'indisi, ya'ni uning 'chegarasi'.","emotion":"happy","board":[{"op":"write","id":"title","x":50,"y":40,"text":"Ko'pburchak perimetri","size":"l","color":"ink"},{"op":"rect","id":"shape1","x":400,"y":100,"w":200,"h":150,"color":"blue"},{"op":"write","id":"p_def","x":50,"y":120,"text":"Perimetr (P) = hamma tomonlar yig'indisi","size":"m","color":"green"}]},{"id":"p2","type":"explain","say":"Keling, blokma-blok quramiz! Mana bu to'rtburchakning tomonlari: uch santimetr va besh santimetr.","emotion":"neutral","board":[{"op":"write","id":"s1","x":480,"y":80,"text":"5 sm","size":"s","color":"ink"},{"op":"write","id":"s2","x":610,"y":160,"text":"3 sm","size":"s","color":"ink"},{"op":"write","id":"s3","x":480,"y":260,"text":"5 sm","size":"s","color":"ink"},{"op":"write","id":"s4","x":370,"y":160,"text":"3 sm","size":"s","color":"ink"}]},{"id":"p3","type":"ask","say":"Endi hamma tomonlarini qo'shib chiqaramiz. Besh qo'shuv uch, yana besh va yana uch. Jami qancha bo'ladi?","emotion":"encouraging","board":[{"op":"write","id":"calc1","x":50,"y":220,"text":"P = 5 + 3 + 5 + 3 = ?","size":"m","color":"red"}],"expect":{"kind":"number","answer":"16","prompt":"P = ?"}},{"id":"p4","type":"praise","say":"Barakalla! To'g'ri, o'n olti santimetr. Sen perimetrni topishni tushunib olding!","emotion":"excited","board":[{"op":"write","id":"calc1_res","x":50,"y":220,"text":"P = 5 + 3 + 5 + 3 = 16 sm","size":"m","color":"green"}]},{"id":"p5","type":"explain","say":"Endi qiyinroq blokga o'tamiz. Agar barcha tomonlari teng bo'lgan kvadrat bo'lsa, har bir tomoni to'rt santimetr.","emotion":"thinking","board":[{"op":"erase","target":"all"},{"op":"rect","id":"sq","x":400,"y":100,"w":150,"h":150,"color":"purple"},{"op":"write","id":"sq_side","x":450,"y":80,"text":"4 sm","size":"s","color":"ink"},{"op":"write","id":"sq_note","x":50,"y":100,"text":"Kvadrat: barcha tomonlar teng","size":"m","color":"purple"}]},{"id":"p6","type":"ask","say":"Kvadratning to'rtta tomoni bor va har biri to'rt santimetr. Perimetri qancha bo'ladi?","emotion":"encouraging","board":[{"op":"write","id":"calc2","x":50,"y":200,"text":"P = 4 * 4 = ?","size":"m","color":"red"}],"expect":{"kind":"number","answer":"16","prompt":"P = ?"}},{"id":"p7","type":"praise","say":"Ajoyib! Yana o'n olti chiqdi. Sen geometriya ustasi bo'lyapsan!","emotion":"happy","board":[{"op":"write","id":"calc2_res","x":50,"y":200,"text":"P = 4 * 4 = 16 sm","size":"m","color":"green"}]},{"id":"p8","type":"explain","say":"Bugun biz perimetrni, ya'ni shaklning chegarasini hisoblashni o'rgandik. Faqat hamma tomonlarni qo'shish kifoya!","emotion":"excited","board":[{"op":"write","id":"final","x":50,"y":300,"text":"Xulosa: P = a + b + c + ...","size":"l","color":"blue"}]}]